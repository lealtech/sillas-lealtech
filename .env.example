# Development-only PostgreSQL credentials.
# Copy this file to .env and replace the values before starting Docker Compose.
POSTGRES_USER=sillas
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sillas_lealtech
POSTGRES_PORT=5433
POSTGRES_SCHEMA=sillas-lealtech

# Used by Prisma CLI (prisma.config.ts) and by the runtime adapter (lib/prisma.ts).
DATABASE_URL=postgresql://sillas:change_me@localhost:5433/sillas_lealtech
